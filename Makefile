# Компилятор C
CC = gcc

# Флаги компиляции:
# -Wall -Wextra: Включают расширенные предупреждения
# -std=c11: Используется стандарт C11
# -O3: Высокий уровень оптимизации
# -Iinclude: Добавляет директорию include в путь поиска заголовочных файлов
CFLAGS = -Wall -Wextra -std=c11 -O3 -Iinclude

# Флаги линковщика
# -lm: Подключает математическую библиотеку
LDFLAGS = -lm

# Директории проекта
SRCDIR = src      # Директория с исходными файлами
INCDIR = include  # Директория с заголовочными файлами
OBJDIR = obj      # Директория для объектных файлов
BINDIR = bin      # Директория для исполняемого файла

# Имя и путь к финальному исполняемому файлу
TARGET = $(BINDIR)/Zephyr-Engine.exe

# Поиск всех .c файлов в директории src
SOURCES = $(wildcard $(SRCDIR)/*.c)

# Преобразование списка .c файлов в список .o файлов в директории obj
OBJECTS = $(patsubst $(SRCDIR)/%.c, $(OBJDIR)/%.o, $(SOURCES))

# Поиск всех заголовочных файлов для отслеживания зависимостей
HEADERS = $(wildcard $(INCDIR)/*.h) $(wildcard $(SRCDIR)/*.h)

# Специальные цели, которые не представляют собой файлы
.PHONY: all clean run

# Цель по умолчанию - сборка всего проекта
all: $(TARGET)

# Правило для создания исполняемого файла
# Зависит от всех объектных файлов и директории bin
$(TARGET): $(OBJECTS) | $(BINDIR)
    $(CC) $(OBJECTS) -o $@ $(LDFLAGS)
    @echo "Сборка завершена: $@"

# Правило для создания объектных файлов из исходных
# Зависит от соответствующего .c файла и всех .h файлов
$(OBJDIR)/%.o: $(SRCDIR)/%.c $(HEADERS) | $(OBJDIR)
    $(CC) $(CFLAGS) -c $< -o $@
    @echo "Скомпилирован: $< -> $@"

# Создание директории для объектных файлов, если её нет
$(OBJDIR):
    mkdir -p $(OBJDIR)

# Создание директории для исполняемого файла, если её нет
$(BINDIR):
    mkdir -p $(BINDIR)

# Очистка проекта - удаление всех сгенерированных файлов
clean:
    rm -rf $(OBJDIR) $(BINDIR)
    @echo "Очистка завершена"

# Запуск собранного приложения
run: $(TARGET)
    ./$(TARGET)

# Зависимость объектных файлов от самого Makefile
$(OBJECTS): $(MAKEFILE_LIST)