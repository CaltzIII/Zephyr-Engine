# Компилятор C (предполагается, что запускается из терминала MSYS2/MINGW где gcc доступен)
CC = gcc

# Флаги компиляции
# -Wall -Wextra: Включают полезные предупреждения
# -std=c11: Использует стандарт C11
# -O3: Высокий уровень оптимизации (подходит для финальной сборки, для отладки можно использовать -g -O0)
# -Iinclude: Добавляет директорию include в путь поиска заголовочных файлов
CFLAGS = -Wall -Wextra -std=c11 -O3 -Iinclude

# Флаги линковщика
# -lm: Линкуется с математической библиотекой (если используете sqrt, pow и т.д. в eval.c)
# Для Windows/MinGW это часто не обязательно для libc, но лучше указать на всякий случай,
# особенно если будут использоваться функции из math.h
LDFLAGS = -lm

# Директории
SRCDIR = src
INCDIR = include
OBJDIR = obj
BINDIR = bin

# Имя исполняемого файла (.exe добавится автоматически в Windows, но можно указать явно)
TARGET = $(BINDIR)/Zephyr-Engine.exe

# Найти все .c файлы в директории src
SOURCES = $(wildcard $(SRCDIR)/*.c)

# Преобразовать список .c файлов в список .o файлов в директории obj
# patsubst заменяет шаблон: %.c -> %.o, а добавление $(OBJDIR)/ ставит их в нужную папку
OBJECTS = $(patsubst $(SRCDIR)/%.c, $(OBJDIR)/%.o, $(SOURCES))

# Все заголовочные файлы (для зависимостей)
HEADERS = $(wildcard $(INCDIR)/*.h) $(wildcard $(SRCDIR)/*.h)

# Специальная цель .PHONY указывает, что эти цели не являются файлами
.PHONY: all clean run

# Цель по умолчанию (первая цель, выполняемая при запуске make без аргументов)
# Зависит от TARGET
all: $(TARGET)

# Правило для создания исполняемого файла
# Зависит от всех объектных файлов
# Команда: линковщик (CC) создает TARGET из OBJECTS с флагами LDFLAGS
$(TARGET): $(OBJECTS) | $(BINDIR)
    $(CC) $(OBJECTS) -o $@ $(LDFLAGS)
    @echo "Сборка завершена: $@"

# Правило для создания объектных файлов (.o) из исходных файлов (.c)
# $< - первая зависимость (исходный .c файл)
# $@ - цель правила (объектный .o файл)
# Зависит от соответствующего .c файла и всех .h файлов (для пересборки при их изменении)
$(OBJDIR)/%.o: $(SRCDIR)/%.c $(HEADERS) | $(OBJDIR)
    $(CC) $(CFLAGS) -c $< -o $@
    @echo "Скомпилирован: $< -> $@"

# Создание директорий, если их нет
$(OBJDIR):
    mkdir -p $(OBJDIR)

$(BINDIR):
    mkdir -p $(BINDIR)

# Цель для очистки проекта
# Удаляет объектные файлы и исполняемый файл
clean:
    rm -rf $(OBJDIR) $(BINDIR)
    @echo "Очистка завершена"

# Цель для запуска собранного движка (удобно для тестирования)
# В Windows исполняемый файл должен заканчиваться на .exe
run: $(TARGET)
    ./$(TARGET)

# Дополнительное правило: если Makefile изменится, пересобрать всё
$(OBJECTS): $(MAKEFILE_LIST)